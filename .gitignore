node_modules/
dist/
storybook-static/
*.local
.DS_Store
.env
.env.*
!.env.example

# `.dev.vars` IS committed: it holds no secret, only the localhost-scoped development switch that
# makes `pnpm builder:worker` usable in a fresh clone. `.dev.vars.*` variants are not.
/.dev.vars.*

# wrangler's local state: the Durable Objects' SQLite files for `pnpm builder:worker`, and its build
# cache. Local pages are meant to be throwaway; the deployed Worker has the real ones.
/.wrangler/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# media/ is the pressure valve for oversized or raw footage — git-ignored on purpose. Compressed page
# assets live in assets/ and ARE committed, so the deployed Storybook is self-contained. See
# media/README.md for which is which.
/media/*
!/media/README.md
