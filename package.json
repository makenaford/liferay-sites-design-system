{
  "name": "scratch",
  "version": "0.1.0",
  "description": "React + Mantine component library generated from the Figma \"Solutions Library- 2026\" design library.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm tokens:check && tsc --noEmit && vite build",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish",
    "storybook:6007": "storybook dev -p 6007 --no-open"
  },
  "peerDependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.5.2",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
