{
  "name": "liferay-sites-design-system",
  "version": "0.1.0",
  "description": "React + Mantine component library generated from the Figma \"Solutions Library- 2026\" design library.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "assets:check": "node scripts/check-asset-size.mjs",
    "build": "pnpm tokens:check && pnpm icons:check && pnpm glass-icons:check && pnpm builder:catalog:check && pnpm assets:check && tsc --noEmit && pnpm builder:typecheck && vite build && pnpm builder:build",
    "build-storybook": "storybook build",
    "builder:build": "vite build --config vite.builder.config.ts && pnpm builder:ssr",
    "builder:catalog": "node scripts/build-builder-catalog.mjs",
    "builder:catalog:check": "node scripts/build-builder-catalog.mjs --check",
    "builder:deploy": "pnpm builder:build && wrangler deploy",
    "builder:dev": "vite --config vite.builder.config.ts",
    "builder:ssr": "vite build --config vite.ssr.config.ts",
    "builder:typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "builder:worker": "wrangler dev",
    "dev": "vite",
    "figma:drift": "node scripts/check-figma-drift.mjs",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish",
    "glass-icons": "node scripts/build-glass-icons.mjs",
    "glass-icons:check": "node scripts/build-glass-icons.mjs --check",
    "icons": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:6007": "storybook dev -p 6007 --no-open",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@figma/code-connect": "^1.5.2",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@mingcute/svg": "3.0.2",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wrangler": "^4.124.0"
  }
}
